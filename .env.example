# Copy this file to .env and fill in a real key to run the live LLM path
# locally. .env is gitignored - it will never be committed or pushed to
# GitHub. Leave both blank (or don't create .env at all) to run in
# template-fallback mode, which is what this submission's dataset used.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides - defaults are already sensible, only touch these
# if you want a different model
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o-mini

# Optional LangChain personalization backend. Install requirements-langchain.txt
# first, then set this to langchain (or auto). Default direct = provider SDK.
PERSONALIZE_BACKEND=direct

# Optional - only needed if you flip DRY_RUN to False in config.py to
# send real emails
# SMTP_USER=
# SMTP_PASSWORD=
